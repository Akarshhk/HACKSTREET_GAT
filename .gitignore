# ============================================================
# Root .gitignore — covers both BACKEND (Python) and frontend (Node/React)
# ============================================================

# ---------------------------
# Python / Backend
# ---------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3

# Virtual environments
venv/
.venv/
env/

# Secrets & environment variables
.env
.env.local
.env.*.local

# One-time scripts (don't commit to prod)
seed_admin.py

# ---------------------------
# Node / Frontend
# ---------------------------
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------
# Editor & OS
# ---------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
